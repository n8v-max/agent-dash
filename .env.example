# Production origin of the deployed dashboard.
# Written into .env.local by scripts/setup-vercel.sh during the Vercel import.
# Intended consumers: metadataBase for OG tags, and Playwright's BASE_URL.
# On Vercel this is also available as the system var VERCEL_PROJECT_PRODUCTION_URL
# (no scheme), so app code should prefer that and fall back to this locally.
NEXT_PUBLIC_SITE_URL=https://agent-use-dash.vercel.app
